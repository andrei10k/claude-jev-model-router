{
  "name": "claude-model-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local routing proxy for Claude Code: sticky, agent-aware model selection with a Jev-ready classifier seam.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claude-model-router": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
